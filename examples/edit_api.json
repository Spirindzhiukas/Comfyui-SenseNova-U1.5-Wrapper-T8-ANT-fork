      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "EmptySenseNovaLatentImage",
    "inputs": {
      "width": 2048,
      "height": 2048,
      "batch_size": 1
    }
  },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["7", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["11", 0]
