      "positive": ["3", 0],
      "negative": ["4", 0],
      "image": ["5", 0]
    }
  },
  "7": {
    "class_type": "SenseNovaEditGuider",
    "inputs": {
      "model": ["2", 0],
      "positive": ["6", 0],
