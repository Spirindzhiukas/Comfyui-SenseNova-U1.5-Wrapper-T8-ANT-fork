# Keep every byte-pinned asset LF-only. The bundled tokenizer files are
# validated with sha256 in sensenova_u15/loader.py, and a Windows clone made
# with core.autocrlf=true would otherwise rewrite them to CRLF and trip the
# "tokenizer asset digest mismatch" error.
sensenova_u15/tokenizer/* text eol=lf
sensenova_u15/checkpoint_contract.json text eol=lf

# Normalise the sources themselves so future digests and diffs stay stable
# across platforms.
*.py text eol=lf
*.json text eol=lf
*.js text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.safetensors binary
